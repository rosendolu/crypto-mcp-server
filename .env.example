# --- Exchange API credentials (optional) -------------------------------------
# Public market-data tools work without any credentials.
# Portfolio and trading tools require keys. For every exchange set
# <EXCHANGE_ID>_API_KEY and <EXCHANGE_ID>_SECRET.

BINANCE_API_KEY=
BINANCE_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
GATE_API_KEY=
GATE_SECRET=

# --- Server options ----------------------------------------------------------
# Exchange used when a tool call omits the `exchange` argument.
# Falls back to the first configured exchange, then to binance.
DEFAULT_EXCHANGE=binance

# Permission ladder (default: analysis = public market data + indicators)
#   market     get_ticker, get_candles, get_order_book, get_recent_trades,
#              get_funding_rate, get_funding_history, get_open_interest, get_basis,
#              get_long_short_ratio, compare_markets, list_exchanges,
#              get_capabilities, get_server_info
#   analysis   + analyze_indicators, get_multi_timeframe_analysis, detect_patterns,
#              get_market_regime, scan_market
#   portfolio  + get_balance, get_orders, get_portfolio, get_positions
#   trading    + place_order, cancel_order
PERMISSION_LEVEL=analysis

# Optional aliases. ENABLE_TRADING=true always selects trading.
ENABLE_PORTFOLIO=false
ENABLE_TRADING=false

# Exchange request timeout in milliseconds.
EXCHANGE_TIMEOUT_MS=30000

# Retry transient network / rate-limit / timeout errors.
EXCHANGE_RETRY_ATTEMPTS=3
EXCHANGE_RETRY_BACKOFF_MS=250

# Minimum spacing between calls to the same exchange (in addition to CCXT rateLimit).
EXCHANGE_MIN_INTERVAL_MS=50

# Public-data fallbacks when the primary venue is unavailable.
EXCHANGE_FALLBACKS=okx,bybit

# Outbound HTTP(S) proxy for exchange requests, e.g. http://127.0.0.1:7890.
# CCXT's async client does not read HTTPS_PROXY on its own, so the server applies
# the proxy explicitly. HTTPS_PROXY / HTTP_PROXY are used when this is empty.
CRYPTO_MCP_PROXY=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
